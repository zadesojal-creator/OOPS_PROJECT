rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ClinicQueue Architecture: 
    // The React frontend communicates strictly with the Node.js Integration API.
    // The Node.js API uses the Firebase Admin SDK, which bypasses these rules.
    // Therefore, to maximize security, we block all direct client access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
